        </mxCell>
        <mxCell id="D5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" value="HQ views import result" vertex="1">
          <mxGeometry height="60" width="200" x="1090" y="1265" as="geometry" />
